# Shared secret required in the `x-faf-shared-secret` header on every
# POST /api/cycle request (design.md Threat Matrix, T-2 — SSRF/abuse
# protection on the public inbound n8n trigger endpoint). Generate a long
# random value and configure it identically in n8n's HTTP Request node and
# in this app's deployment environment. Never commit a real value here.
FAF_CYCLE_SHARED_SECRET=

# Server-only Claude API key for GET /api/decisions/[asset]/narrative (D7,
# design.md Threat Matrix T-5). Read only inside a `runtime='nodejs'` route
# handler, never NEXT_PUBLIC_-prefixed, never reaches the client bundle. If
# absent, the narrative endpoint degrades gracefully to `503
# NARRATIVE_DISABLED` — every other route and GET /api/decisions itself are
# completely unaffected (D7 clause 4).
# IMPORTANT: this endpoint is public-triggered and cost-bearing per request
# (T-3). Rate limiting, response caching, and max_tokens caps mitigate but
# do NOT hard-cap spend on their own (they are per-instance, not global) —
# configure a spend cap on this key in the Anthropic console; that is the
# only hard ceiling.
ANTHROPIC_API_KEY=

# Upstash Redis REST connection for the presentation cache
# (src/cycle/latest.ts, src/narrative/cache.ts — see
# presentation-cache-persistence design.md). Both are required; a missing
# value surfaces as a caught runtime error inside the cache's get/put calls,
# not an import-time crash (src/lib/redis.ts's lazy-singleton pattern).
# Provision "Upstash for Redis" via the Vercel Marketplace or a direct
# Upstash account, then copy the REST URL/token it issues here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
